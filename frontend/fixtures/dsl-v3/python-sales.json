  "queries": {
    "q1": {
      "query_id": "q1",
      "raw_sql": "SELECT category, CAST(total_sales AS DECIMAL(12,2)) AS total_sales FROM qs_cmf_13_3.qs_sales_by_film_category ORDER BY total_sales DESC",
      "params": [],
      "masked_columns": []
    },
    "q2": {
      "query_id": "q2",
      "raw_sql": "SELECT SUM(amount) AS total_revenue FROM qs_cmf_13_3.qs_payment",
      "params": [],
      "masked_columns": []
    },
    "q3": {
      "query_id": "q3",
      "raw_sql": "SELECT c.customer_id AS customer_id, CONCAT(c.first_name, ' ', c.last_name) AS customer_name, c.email AS email, CAST(SUM(p.amount) AS DECIMAL(10,2)) AS total_spent, COUNT(p.payment_id) AS rental_count\nFROM qs_cmf_13_3.qs_customer c\nJOIN qs_cmf_13_3.qs_payment p ON c.customer_id = p.customer_id\nGROUP BY c.customer_id, c.first_name, c.last_name, c.email\nORDER BY total_spent DESC\nLIMIT 10",
      "params": [],
      "masked_columns": []
    }
  },

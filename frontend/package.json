{
  "name": "qscmf-chat2viz-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Chat2Viz Dashboard frontend build pipeline for v13 (Webpack)",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config .eslintrc.cjs \"entries/**/*.{ts,tsx}\" \"../asset/inertia/Chat2viz/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --config .eslintrc.cjs \"entries/**/*.{ts,tsx}\" \"../asset/inertia/Chat2viz/**/*.{ts,tsx}\" --fix",
    "test": "vitest run",
    "test:node": "node --test tests/node-smoke.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "antd": "^5.0.0",
    "immer": "^10.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^1.4.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "zundo": "^2.3.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.41",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-grid-layout": "^1.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "css-loader": "^6.10.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^25.0.0",
    "mini-css-extract-plugin": "^2.8.0",
    "swc-loader": "^0.2.7",
    "ts-loader": "^9.5.0",
    "typescript": "^5.4.0",
    "vitest": "^4.0.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0"
  }
}

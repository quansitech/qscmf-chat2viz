{
    "name": "quansitech/qscmf-chat2viz",
    "description": "QSCMF NL2Data-Visualization package: turn natural language into SQL queries and render them as G2 charts.",
    "type": "library",
    "keywords": [
        "thinkphp",
        "qscmf",
        "nl2sql",
        "chat2viz",
        "visualization",
        "g2",
        "langgraph"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "xhiny",
            "email": "axhiny@163.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../qscmf-sse-core",
            "options": {
                "symlink": false
            }
        }
    ],
    "require": {
        "php": ">=8.1",
        "tiderjian/think-core": ">=13.0.0 <14.0.0",
        "guzzlehttp/guzzle": "^7.0",
        "quansitech/qscmf-sse-core": "^1.1.0"
    },
    "autoload": {
        "psr-4": {
            "Qscmf\\Chat2Viz\\": "src/"
        }
    },
    "extra": {
        "qscmf": {
            "providers": [
                "Qscmf\\Chat2Viz\\Chat2VizServiceProvider"
            ]
        }
    }
}

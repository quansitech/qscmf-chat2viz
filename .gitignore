# Composer
vendor/
composer.lock

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Logs
*.log

# Env
.env
.env.local

# Build output (generated by webpack)
asset/chat2viz-dashboard/*.js
asset/chat2viz-dashboard/*.css
asset/chat2viz-dashboard/*.LICENSE.txt
# Source maps (contain original source — never commit)
asset/chat2viz-dashboard/*.js.map
asset/chat2viz-dashboard/*.css.map
# Playwright/test runner output (regenerated each run)
asset/chat2viz-dashboard/test-results/

# E2E run artifacts (screenshots, recordings, DOM/console dumps, run reports)
# 这些是测试运行产物，含本地主机名/内网 IP/DB 名等环境信息，不入库。
# 入库的测试资产放在 specs/ lib/ deterministic/，不含运行时 metadata。
tests/e2e/artifacts/
tests/e2e-browser/artifacts/

# Frontend dependencies
frontend/node_modules/
frontend/package-lock.json
# Webpack filesystem cache (persists between builds; safe to delete to force cold rebuild)
frontend/.webpack-cache/

# Composer (package is a path repository, uses root project's vendor)
vendor/
composer.lock

# ThinkPHP runtime (generated when ROOT_PATH was misresolved)
app/

# dual-model eval worktrees
.worktrees/

# OpenSpec docs (kept locally, not versioned)
openspec/
.claude/

phpunit.xml
.phpunit.cache/

CLAUDE.md

AGENT.md

CONTRIBUTING.md

.playwright-mcp

AUDIT_REPORT.md.codegraph/

